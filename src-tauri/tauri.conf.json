{
  "productName": "Wiki Labs AI Copilot",
  "version": "1.1.209",
  "identifier": "com.wikilabs.copilot",
  "build": {
    "frontendDist": "../src/frontend/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Wiki Labs AI Copilot",
        "width": 1100,
        "height": 750,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "transparent": false,
        "devtools": true,
        "create": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis"
    ],
    "resources": {
      "../src/skills": "skills/",
      "../src/engineering-foundations": "knowledge/",
      "assets": "assets/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {}
}